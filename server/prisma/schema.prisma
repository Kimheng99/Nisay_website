generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SHOP_OWNER
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

enum ShopStatus {
  PENDING
  ACTIVE
  SUSPENDED
  CLOSED
}

enum ShopApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ShopOrderStatus {
  PENDING
  CONFIRMED
  SHIPPING
  COMPLECTED
  CANCELLED
}

enum PaymentMethod {
  COD
  CREDIT_CARD
  BANK_TRANSFER
  E_WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum AdminActionType {
  DELETE_USER
  SUSPEND_USER
  DELETE_SHOP
  SUSPEND_SHOP
  APPROVE_SHOP
  REJECT_SHOP
  CHANGE_ROLE
}
enum Province {
  PHNOM_PENH
  BANTEAY_MEANCHEY
  BATTAMBANG
  KAMPONG_CHAM
  KAMPONG_CHHNANG
  KAMPONG_SPEU
  KAMPONG_THOM
  KAMPOT
  KANDAL
  KEP
  KOH_KONG
  KRATIE
  MONDULKIRI
  ODDAR_MEANCHEY
  PAILIN
  PREAH_SIHANOUK
  PREAH_VIHEAR
  PURSAT
  RATTANAKIRI
  SIEM_REAP
  STUNG_TRENG
  SVAY_RIENG
  TAKEO
  TBONG_KHMUM
  PREY_VENG
}

model User {
  id String @id @default(uuid())
  name String
  email String @unique
  password String
  role Role @default(CUSTOMER)
  status UserStatus @default(ACTIVE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  shop Shop?
  cart Cart?
  addresses Address[]
  orders Order[]
  shopApplications ShopApplication[] @relation("Applicant")
  reviewApps ShopApplication[] @relation("Reviewer")
  adminActions AdminActionLog[]
  @@index([role])
  @@index([status])
  @@index([email])
}

model Address {
  id String @id @default(uuid())
  receiverName String
  phone String
  city String
  district String
  street String
  userId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id])
  @@index([userId])
}

model ShopApplication {
  id           String                @id @default(uuid())
  userId       String
  shopName     String
  status       ShopApplicationStatus @default(PENDING)
  reviewedById String? 
  reviewedAt   DateTime?
  rejectReason String?
  createdAt    DateTime              @default(now())

  applicant  User  @relation("Applicant", fields: [userId], references: [id])
  reviewedBy User? @relation("Reviewer", fields: [reviewedById], references: [id])

  @@index([userId])
  @@index([status])
}

model Shop {
  id          String     @id @default(uuid())
  ownerId     String     @unique 
  shopName    String
  logo        String?
  description String?
  address     String?
  phone       String?
  province    Province
  nearFee     Decimal @default(0) @db.Decimal(12,2)
  farFee      Decimal @default(0) @db.Decimal(12,2)
  status      ShopStatus @default(PENDING)
  deletedAt   DateTime? 
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  owner      User        @relation(fields: [ownerId], references: [id])
  products   Product[]
  shopOrders ShopOrder[]

  @@index([status])
}

model Category {
  id       String    @id @default(uuid())
  name     String    @unique
  products Product[]

  @@index([name]) // hỗ trợ tìm theo tên danh mục
}

model Product {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Decimal  @db.Decimal(12, 2)
  discountedPrice Decimal? @db.Decimal(12,2)
  stock       Int      @default(0)
  rating      Decimal? @db.Decimal(3, 2) // giá trị tổng hợp; tính lại khi có bảng Review
  thumbnail   String? // ảnh bìa; ảnh phụ nằm ở ProductImage
  categoryId  String
  shopId      String
  createdAt   DateTime @default(now())

  category   Category       @relation(fields: [categoryId], references: [id])
  shop       Shop           @relation(fields: [shopId], references: [id])
  images     ProductImage[]
  cartItems  CartItem[]
  orderItems OrderItem[]

  
  @@index([name]) 
  @@index([categoryId]) 
  @@index([shopId]) 
  @@index([price]) 
  @@index([categoryId, price]) 
}

model ProductImage {
  id        String @id @default(uuid())
  imageUrl  String
  productId String

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Cart {
  id     String     @id @default(uuid())
  userId String     @unique
  items  CartItem[]

  user User @relation(fields: [userId], references: [id])
}

model CartItem {
  id        String @id @default(uuid())
  cartId    String
  productId String
  quantity  Int    @default(1)

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@index([productId])
}



model Order {
  id           String   @id @default(uuid())
  userId       String
  totalAmount  Decimal  @db.Decimal(12, 2) 
  receiverName String
  shippingAddress  String
  shippingProvince Province
  createdAt    DateTime @default(now())
  user       User        @relation(fields: [userId], references: [id])
  shopOrders ShopOrder[] 
  payment    Payment?

  @@index([userId])
  @@index([createdAt])
}



model ShopOrder {
  id          String          @id @default(uuid())
  shopId      String
  orderId     String
  subTotal    Decimal         @db.Decimal(12, 2) 
  shippingFee Decimal         @default(0) @db.Decimal(12, 2)
  status      ShopOrderStatus @default(PENDING)
  createdAt   DateTime        @default(now())

  shop  Shop        @relation(fields: [shopId], references: [id])
  order Order       @relation(fields: [orderId], references: [id])
  items OrderItem[]

  @@index([shopId])
  @@index([orderId])
  @@index([status])
  @@index([shopId, status, createdAt])
}

model OrderItem {
  id          String  @id @default(uuid())
  shopOrderId String
  productId   String
  productName String 
  price       Decimal @db.Decimal(12, 2) 
  quantity    Int

  shopOrder ShopOrder @relation(fields: [shopOrderId], references: [id])
  product   Product   @relation(fields: [productId], references: [id])

  @@index([shopOrderId])
  @@index([productId])
}



model Payment {
  id      String        @id @default(uuid())
  orderId String        @unique
  method  PaymentMethod
  status  PaymentStatus @default(PENDING)
  amount  Decimal       @db.Decimal(12, 2)
  paidAt  DateTime?

  order Order @relation(fields: [orderId], references: [id])

  @@index([status])
}



model AdminActionLog {
  id         String          @id @default(uuid())
  adminId    String
  actionType AdminActionType
  targetType String
  targetId   String
  reason     String?
  createdAt  DateTime        @default(now())

  admin User @relation(fields: [adminId], references: [id])

  @@index([adminId])
  @@index([targetType, targetId])
}